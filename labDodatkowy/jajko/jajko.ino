void setup() {
  Serial.begin(9600);

  // Inicjalizacja ekranu
  if(!display.begin(i2c_Address, true)) {
    Serial.println(F("Nie znaleziono wyswietlacza SH1106"));
    for(;;);
  }

  display.clearDisplay();

  // Wyświetlenie bitmapy
  // Parametry: (x, y, dane_bitmapy, szerokość, wysokość, kolor)
  // Wyśrodkowanie: x = (128-64)/2 = 32, y = (64-64)/2 = 0
  display.drawBitmap(32, 0, logo16_glcd_bmp, LOGO_WIDTH, LOGO_HEIGHT, SH110X_WHITE);
  
  display.display();
}

void loop() {
  // Pusta pętla - obrazek już jest wyświetlony
}
